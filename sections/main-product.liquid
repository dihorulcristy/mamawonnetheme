{%- comment -%} Main Product Section {%- endcomment -%}

<section class="product-page">
  <div class="container">
    <nav class="product-breadcrumbs" aria-label="Brotkrümel">
      <a href="{{ routes.root_url }}">Startseite</a>
      <span>/</span>
      {%- if product.collections.size > 0 -%}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <span>/</span>
      {%- endif -%}
      <span>{{ product.title }}</span>
    </nav>

    <div class="product-page__inner">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="product-gallery">
        <div class="product-gallery__main" data-lightbox-trigger>
          <div class="product-gallery__slider" id="ProductGallerySlider">
            {%- for image in product.images -%}
              <div class="product-gallery__slide" data-index="{{ forloop.index0 }}">
                {%- if forloop.first -%}
                  {{ image | image_url: width: 1500 | image_tag: 
                    loading: 'eager', 
                    sizes: '(min-width: 768px) 50vw, 100vw', 
                    widths: '400, 600, 800, 1000, 1200, 1500',
                    alt: image.alt | escape 
                  }}
                {%- else -%}
                  {{ image | image_url: width: 1500 | image_tag: 
                    loading: 'lazy', 
                    sizes: '(min-width: 768px) 50vw, 100vw', 
                    widths: '400, 600, 800, 1000, 1200, 1500',
                    alt: image.alt | escape 
                  }}
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="product-gallery__slide">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for image in product.images -%}
              <button class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}" aria-label="Bild {{ forloop.index }}"
                data-src="{{ image | image_url: width: 1500 }}"
                data-srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1000 }} 1000w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1500 }} 1500w"
              >
                {{ image | image_url: width: 150 | image_tag: 
                  loading: 'lazy', 
                  sizes: '64px', 
                  widths: '64, 128',
                  alt: image.alt | escape
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product Info {%- endcomment -%}
      <div class="product-info">
        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__rating">
          <span class="product-info__rating-stars">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {%- endfor -%}
          </span>
          <span class="product-info__rating-count">({{ product.metafields.reviews.rating_count | default: '1305' }} Bewertungen)</span>
        </div>

        <div class="product-info__price">
          {{ product.selected_or_first_available_variant.price | money }}
          {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
            <span class="product-info__price--compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        {%- if product.description != blank -%}
          <div class="product-info__description">
            {{ product.description | strip_html | truncatewords: 30 }}
          </div>
        {%- endif -%}

        {%- comment -%} Product Form {%- endcomment -%}
        {% form 'product', product %}
          {%- unless product.has_only_default_variant -%}
            <div class="product-variants">
              {%- for option in product.options_with_values -%}
                <div>
                  <span class="product-variants__label">{{ option.name }}</span>
                  <div class="product-variants__options" data-option="option{{ option.position }}">
                    {%- for value in option.values -%}
                      <button type="button" class="variant-swatch{% if option.selected_value == value %} is-selected{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <script type="application/json" id="ProductJson-{{ section.id }}">
            {{ product.variants | json }}
          </script>

          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <div class="quantity-selector">
            <button type="button" class="quantity-selector__btn" data-qty-minus aria-label="Weniger">−</button>
            <input type="number" name="quantity" class="quantity-selector__input" value="1" min="1" aria-label="Menge">
            <button type="button" class="quantity-selector__btn" data-qty-plus aria-label="Mehr">+</button>
          </div>

          <button type="submit" class="product-info__add-to-cart btn btn--primary btn--full"
            {%- unless product.selected_or_first_available_variant.available %} disabled{% endunless -%}>
            {%- if product.selected_or_first_available_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        {% endform %}

        <div class="product-trust-badges">
          <span class="product-trust-badges__item">🔒 Sichere Bezahlung</span>
          <span class="product-trust-badges__item">🚚 Kostenloser Versand ab 100€</span>
          <span class="product-trust-badges__item">↩️ 14 Tage Rückgaberecht</span>
          <span class="product-trust-badges__item">🇩🇪 Made in Europe</span>
        </div>

      </div>
    </div>

    {%- comment -%} Product Details (Moved to bottom) {%- endcomment -%}
    <div class="product-details-bottom">
      {%- for block in section.blocks -%}
        <div class="product-details-bottom__block" {{ block.shopify_attributes }}>
          <h2 class="product-details-bottom__title">{{ block.settings.title }}</h2>
          <div class="product-details-bottom__content">
            {%- if block.type == 'description' -%}
              {{ product.description }}
            {%- else -%}
              {{ block.settings.content }}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Product Lightbox Dialog {%- endcomment -%}
  <dialog class="product-lightbox" id="ProductLightbox">
    <button class="product-lightbox__close" aria-label="Schließen" formmethod="dialog">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="product-lightbox__slider">
      {%- for image in product.images -%}
        <div class="product-lightbox__slide" data-index="{{ forloop.index0 }}">
          {{ image | image_url: width: 2000 | image_tag: 
            loading: 'lazy', 
            sizes: '100vw', 
            widths: '800, 1000, 1500, 2000',
            alt: image.alt | escape
          }}
        </div>
      {%- endfor -%}
    </div>
  </dialog>
</section>

{% schema %}
{
  "name": "Produktseite",
  "class": "product-section",
  "settings": [],
  "blocks": [
    {
      "type": "description",
      "name": "Beschreibung",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Beschreibung"
        }
      ]
    },
    {
      "type": "tab",
      "name": "Info-Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Materialien"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Inhalt",
          "default": "<p>Details zu diesem Tab hier einfügen.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Produktseite",
      "blocks": [
        { "type": "description", "settings": { "title": "Beschreibung" } },
        { "type": "tab", "settings": { "title": "Materialien", "content": "<p>100% Bio-Baumwolle, OEKO-TEX Standard 100 zertifiziert.</p>" } },
        { "type": "tab", "settings": { "title": "Pflegehinweise", "content": "<p>Bei 40°C waschbar. Trocknergeeignet. Kein Weichspüler verwenden.</p>" } },
        { "type": "tab", "settings": { "title": "Versand", "content": "<p>Versand innerhalb von 1-2 Werktagen. Kostenloser Versand ab 100€.</p>" } }
      ]
    }
  ]
}
{% endschema %}
