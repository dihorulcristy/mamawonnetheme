{%- comment -%} Main Cart Page Section {%- endcomment -%}

<section class="cart-page" id="CartPage">
  <div class="container">
    <h1>{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="cart-page__empty" id="CartEmpty">
        <p>{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="margin-top:20px">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <div class="cart-page__layout">
        <div class="cart-page__items" id="CartItems">
          {%- for item in cart.items -%}
            <div class="cart-page__item" data-item-key="{{ item.key }}">
              <div class="cart-page__item-image">
                {%- if item.image -%}
                  <a href="{{ item.url }}">
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" loading="lazy">
                  </a>
                {%- endif -%}
              </div>
              <div class="cart-page__item-info">
                <h3 class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                {%- unless item.variant.title == 'Default Title' -%}
                  <p class="cart-page__item-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-item__price" data-line-price="{{ item.key }}">{{ item.final_line_price | money }}</p>
              </div>
              <div class="cart-page__item-actions">
                <div class="quantity-selector">
                  <button type="button" class="quantity-selector__btn" data-cart-qty-minus data-key="{{ item.key }}" data-qty="{{ item.quantity }}" aria-label="Weniger">−</button>
                  <input type="number" class="quantity-selector__input" value="{{ item.quantity }}" min="0" data-qty-input="{{ item.key }}" aria-label="Menge" readonly>
                  <button type="button" class="quantity-selector__btn" data-cart-qty-plus data-key="{{ item.key }}" data-qty="{{ item.quantity }}" aria-label="Mehr">+</button>
                </div>
                <button type="button" class="cart-item__remove" data-cart-remove data-key="{{ item.key }}">{{ 'cart.remove' | t }}</button>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart-page__summary" id="CartSummary">
          <div class="cart-page__summary-inner">
            <h2 class="cart-page__summary-title">Bestellübersicht</h2>
            <div class="cart-page__summary-row">
              <span>{{ 'cart.subtotal' | t }}</span>
              <span id="CartSubtotal">{{ cart.total_price | money }}</span>
            </div>
            <p class="cart-page__summary-note">{{ 'cart.taxes_note' | t }}. {{ 'cart.shipping_note' | t }}.</p>
            <a href="/checkout" class="btn btn--primary btn--full cart-page__checkout" id="CartCheckoutBtn">{{ 'cart.checkout' | t }}</a>
            <a href="{{ routes.all_products_collection_url }}" class="cart-page__continue">{{ 'cart.continue_shopping' | t }}</a>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Warenkorb-Seite",
  "settings": []
}
{% endschema %}
